# JIN Agent — environment variables (example / template)
#
# Asli values KAHIN na rakho — host ke Environment Variables me daalo.
# Har line ka default config.py me mojood hai; khaali chhodna = default.
#
# SECURITY: ye file ke paas asli value NAHI honi chahiye. Repo me `.env` bhi
# gitignored hai. Koi token/key kabhi commit/log/output me na jaye.

# --- Telegram (zaroori) -----------------------------------------------------
# BotFather se bot token (format: 123456789:AA...).
TELEGRAM_BOT_TOKEN=
# Aap ka chat id (allowlist). Unset = ALLOW-ALL (sirf local/test ke liye).
TELEGRAM_CHAT_ID=
# Unset TELEGRAM_CHAT_ID par bhi allow-all NA ho (production me 1 karo).
# 1 = unset chat id par bot startup par rok dega (safe failure).
JIN_AGENT_REQUIRE_CHAT_ID=0

# --- LLM (ikhtiyari — off hone par rule-based Roman Urdu chalta hai) --------
# provider: off | ollama | lmstudio | custom
LLM_PROVIDER=off
# custom ke liye public https endpoint (IP/internal mana hai)
LLM_ENDPOINT=
LLM_MODEL=
# sirf custom provider ke liye (Groq/OpenRouter/...)
GROQ_API_KEY=

# --- Server / console -------------------------------------------------------
# Console host: khaali = 127.0.0.1 (loopback-only). "0.0.0.0" sirf agar
# JIN_AGENT_ADMIN_TOKEN set ho.
JIN_AGENT_HOST=
PORT=8766
# Console admin token. Set ho to Authorization: Bearer <token> / X-Admin-Token
# lazmi (loopback bhi). Khaali = sirf loopback peer allowed.
JIN_AGENT_ADMIN_TOKEN=

# --- Scheduler --------------------------------------------------------------
# off = scheduler band; 1/true = chalu (default)
JIN_AGENT_SCHEDULER=1
# 1 = scheduler offline (test fixtures) mode me chale. Default 0 = LIVE.
JIN_AGENT_SCHEDULER_OFFLINE=0

# --- Data / retention -------------------------------------------------------
JIN_AGENT_DATA=
JIN_AGENT_RETENTION_DAYS=90
JIN_AGENT_TRACE_DAYS=30
JIN_AGENT_BACKUP_KEEP=7
JIN_AGENT_REPORT_DAYS=90
JIN_AGENT_SOURCE_STALE_DAYS=30
JIN_AGENT_MEMORY_STALE_DAYS=30
JIN_AGENT_REPORT_CONFIDENCE=0.6

# --- Workers / limits -------------------------------------------------------
JIN_AGENT_UPDATE_WORKERS=2
JIN_AGENT_CONTROL_WORKERS=4
JIN_AGENT_SEND_DELAY=1.0
JIN_AGENT_MAX_ROUNDS=5
JIN_AGENT_MAX_POLL_FAILURES=5
JIN_AGENT_TOKEN_BUDGET=0
JIN_AGENT_COST_PER_1M=0
JIN_AGENT_LOG_LEVEL=INFO
JIN_AGENT_VERBOSE=0

# --- Channel discovery (config.json ke andar bhi ho sakta hai) -------------
# discovery_cache_seconds=900
# channel_discovery_probe_per_run=8
# channel_discovery_max_auto=60
# channel_min_score=4
